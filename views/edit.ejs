<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>


    
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a class="text-blue-500 inline-block mb-10" href="/">Go Back to Home</a>
         <form action="/edit" method="post">
                <!-- hum /edit route pr ja rhe hai aur method hai post -->
                <input class="block px-5 py-2 bg-zinc-800 w-1/4 rounded-md outline-none cursor-not-allowed " type="text" placeholder="Previous Name" name="previous" value="<%= filename %>">
                <textarea class="block px-5 py-2 bg-zinc-800 resize-none mt-2 w-1/4  rounded-md outline-none" placeholder="New Name" name="new"></textarea>
                <input class="mt-2 bg-yellow-600 px-5 py-2 rounded-md" type="submit" value="Update Name">
            </form>
        
        
    </div>
</body>
</html>