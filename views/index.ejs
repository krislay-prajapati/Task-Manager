<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>


    
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10 text-white">
            <form action="/create" method="post">
                <!-- hum /create route pr ja rhe hai aur method hai post -->
                <input class="block px-5 py-2 bg-zinc-800 w-full rounded-md outline-none " type="text" placeholder="Tilt Goes Here" name="title">
                <textarea class="block px-5 py-2 bg-zinc-800 resize-none mt-2 w-full rounded-md outline-none" placeholder="Write Your Task Details" name="details"></textarea>
                <input class="mt-2 bg-blue-600 px-5 py-2 rounded-md" type="submit" value="Create task">
            </form>

        </div>
        <div class="tasks p-10 flex gap-3 flex-wrap">


            <!-- agar files ka length tmhara 0 se bada hoga to to jitne task tmne likhe the usko baari baari read krte jaao to kitne task read honge ye kaise pta chalega .. to jitna files tmhre files folder me honge  utne task .... agar length 0 se bada nhi hai to no task print kr do bs -->


            <% if(files.length>0){ %>

                <% files.forEach(function(val){ %>
              <div class="task  w-72 px-3 py-4 bg-zinc-800 rounded-md">
                <h1 class="text-white text-3xl tracking-tighter "><%=val %></h1>
                <div class="w-full justify-between items-centre mt-3 ">
                    <a class="text-blue-500 inline-block gap-4 " href="/file/<%= val%>">Read more..</a>
                <a class="text-blue-500 inline-block align-items: flex-end;  " href="/edit/<%= val%>">edit filename</a>
                </div>
                
                
            </div>
             
               <% }) %>
                
           <% }else{%>
                <h3 class="text-zinc-600">no tasks here</h3>
            
           <% } %>
            
            
            
            
            
        </div>
    </div>
</body>
</html>